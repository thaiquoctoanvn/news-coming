# Copy to .env for local runs. Never commit .env. Production values live in
# GitHub Secrets / Supabase Secrets (docs/DESIGN.md §14).

# Supabase (worker only — service_role bypasses RLS)
# Project origin only, e.g. https://<project-ref>.supabase.co (no /rest/v1)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (free tiers only — .agents/rules/cost.md)
GROQ_API_KEY=
GEMINI_API_KEY=
# Prepaid key of a separate Google project, only for the job board's web search (docs/JOBS_PLAN.md §4)
GEMINI_SEARCH_API_KEY=

# Data sources
SEC_USER_AGENT="news-coming your-email@example.com"
FRED_API_KEY=
EIA_API_KEY=
